generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  DESIGNER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DesignerApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  AWAITING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_INITIATED
  DEPOSIT_PAID_DEMO
  PAID_DEMO
  REFUND_PENDING
  REFUNDED_DEMO
  FAILED
}

enum AppointmentType {
  HOME_VISIT
  STUDIO_APPOINTMENT
  ONLINE_CONSULTATION
  SHOPPING_ASSISTANCE
  EVENT_VENUE_VISIT
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  role         UserRole      @default(CUSTOMER)
  status       AccountStatus @default(ACTIVE)
  avatarUrl    String?
  city         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customerProfile CustomerProfile?
  designerProfile DesignerProfile?
  addresses       Address[]
  notifications   Notification[]
  favourites      Favourite[]
  auditLogs       AdminAuditLog[]
}

model CustomerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  preferredStyleTags String[]
  defaultCity        String
  notes              String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  reviews            Review[]
}

model DesignerProfile {
  id                        String                 @id @default(cuid())
  userId                    String                 @unique
  slug                      String                 @unique
  title                     String
  city                      String
  serviceRadiusKm           Int                    @default(25)
  experienceYears           Int                    @default(1)
  rating                    Float                  @default(0)
  reviewCount               Int                    @default(0)
  startingPriceInr          Int
  bio                       String
  skills                    String[]
  supportedAppointmentTypes AppointmentType[]
  coverImageUrl             String?
  isVerified                Boolean                @default(false)
  isFeatured                Boolean                @default(false)
  approvalStatus            DesignerApprovalStatus @default(PENDING_REVIEW)
  commissionOverridePercent Float?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications DesignerVerification[]
  services      Service[]
  portfolios    Portfolio[]
  availability  Availability[]
  slots         AvailabilitySlot[]
  bookings      Booking[]
  reviews       Review[]
  commissions   Commission[]
  payouts       Payout[]
  favourites    Favourite[]

  @@index([city, approvalStatus])
}

model DesignerVerification {
  id                String   @id @default(cuid())
  designerId        String
  documentType      String
  documentRefMasked String
  documentUrl       String
  status            String   @default("PENDING")
  reviewerNotes     String?
  submittedAt       DateTime @default(now())
  reviewedAt        DateTime?
  designer          DesignerProfile @relation(fields: [designerId], references: [id], onDelete: Cascade)
}

model Category {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  groupName      String
  description    String
  imageUrl       String
  commissionRate Float         @default(15)
  isPopular      Boolean       @default(false)
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)
  subcategories  Subcategory[]
  services       Service[]
}

model Subcategory {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  description String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
}

model Service {
  id               String            @id @default(cuid())
  designerId       String
  categoryId       String
  subcategoryName  String
  title            String
  description      String
  priceInr         Int
  durationMinutes  Int
  appointmentTypes AppointmentType[]
  serviceCities    String[]
  travelChargeInr  Int               @default(0)
  imageUrl         String
  isActive         Boolean           @default(true)
  designer         DesignerProfile   @relation(fields: [designerId], references: [id], onDelete: Cascade)
  category         Category          @relation(fields: [categoryId], references: [id])
  packages         ServicePackage[]
  bookings         Booking[]

  @@index([categoryId, isActive])
}

model ServicePackage {
  id            String   @id @default(cuid())
  serviceId     String
  name          String
  description   String
  priceInr      Int
  deliverables  String[]
  durationLabel String
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id            String           @id @default(cuid())
  designerId    String
  title         String
  categoryName  String
  occasion      String
  city          String
  description   String
  coverImageUrl String
  createdAt     DateTime         @default(now())
  designer      DesignerProfile  @relation(fields: [designerId], references: [id], onDelete: Cascade)
  images        PortfolioImage[]
}

model PortfolioImage {
  id          String    @id @default(cuid())
  portfolioId String
  url         String
  caption     String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Availability {
  id                String          @id @default(cuid())
  designerId        String          @unique
  workingDays       String[]
  workingHoursStart String
  workingHoursEnd   String
  breakStart        String?
  breakEnd          String?
  blockedDates      String[]
  designer          DesignerProfile @relation(fields: [designerId], references: [id], onDelete: Cascade)
}

model AvailabilitySlot {
  id          String          @id @default(cuid())
  designerId  String
  date        String
  startTime   String
  endTime     String
  isAvailable Boolean         @default(true)
  isBreak     Boolean         @default(false)
  designer    DesignerProfile @relation(fields: [designerId], references: [id], onDelete: Cascade)
  booking     Booking?

  @@unique([designerId, date, startTime])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String
  line1     String
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Booking {
  id                    String           @id @default(cuid())
  bookingCode           String           @unique
  idempotencyKey        String?          @unique
  customerId            String
  designerId            String
  serviceId             String
  slotId                String?          @unique
  occasion              String
  appointmentType       AppointmentType
  date                  String
  startTime             String
  endTime               String
  addressLabel          String
  addressFull           String
  city                  String
  basePriceInr          Int
  travelFeeInr          Int              @default(0)
  platformServiceFeeInr Int              @default(0)
  discountInr           Int              @default(0)
  totalAmountInr        Int
  depositAmountInr      Int              @default(0)
  paymentMode           String           @default("DEPOSIT")
  paymentStatus         PaymentStatus    @default(UNPAID)
  status                BookingStatus    @default(PENDING)
  rejectionReason       String?
  cancellationReason    String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  customer     CustomerProfile       @relation(fields: [customerId], references: [id])
  designer     DesignerProfile       @relation(fields: [designerId], references: [id])
  service      Service               @relation(fields: [serviceId], references: [id])
  slot         AvailabilitySlot?     @relation(fields: [slotId], references: [id])
  requirements BookingRequirement?
  history      BookingStatusHistory[]
  payments     Payment[]
  refunds      Refund[]
  commission   Commission?
  review       Review?
  conversation Conversation?

  @@index([customerId, status])
  @@index([designerId, date, status])
}

model BookingRequirement {
  id                     String   @id @default(cuid())
  bookingId              String   @unique
  occasionDate           String
  preferredStyle         String
  budgetInr              Int
  peopleCount            Int      @default(1)
  additionalRequirements String
  referenceImageUrls     String[]
  notes                  String?
  booking                Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingStatusHistory {
  id            String        @id @default(cuid())
  bookingId     String
  status        BookingStatus
  changedByRole UserRole
  note          String
  createdAt     DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  gateway        String        @default("RAZORPAY")
  gatewayOrderId String        @unique
  amountInr      Int
  paymentMode    String
  status         PaymentStatus
  createdAt      DateTime      @default(now())
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds        Refund[]
}

model Refund {
  id        String   @id @default(cuid())
  bookingId String
  paymentId String
  amountInr Int
  reason    String
  status    String   @default("REQUESTED")
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  payment   Payment  @relation(fields: [paymentId], references: [id])
}

model Commission {
  id                    String          @id @default(cuid())
  bookingId             String          @unique
  designerId            String
  grossAmountInr        Int
  commissionRatePercent Float
  platformFeeInr        Int
  netDesignerInr        Int
  settled               Boolean         @default(false)
  createdAt             DateTime        @default(now())
  booking               Booking         @relation(fields: [bookingId], references: [id])
  designer              DesignerProfile @relation(fields: [designerId], references: [id])
}

model Payout {
  id            String          @id @default(cuid())
  designerId    String
  amountInr     Int
  periodLabel   String
  status        String          @default("PENDING_SETTLEMENT")
  referenceCode String          @unique
  paidAt        DateTime?
  designer      DesignerProfile @relation(fields: [designerId], references: [id])
}

model Review {
  id               String          @id @default(cuid())
  bookingId        String          @unique
  customerId       String
  designerId       String
  rating           Int
  comment          String
  moderationStatus String          @default("PUBLISHED")
  createdAt        DateTime        @default(now())
  booking          Booking         @relation(fields: [bookingId], references: [id])
  customer         CustomerProfile @relation(fields: [customerId], references: [id])
  designer         DesignerProfile @relation(fields: [designerId], references: [id])
}

model Conversation {
  id        String    @id @default(cuid())
  bookingId String?   @unique
  subject   String
  updatedAt DateTime  @updatedAt
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     UserRole
  body           String
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  role      UserRole
  type      String
  title     String
  message   String
  linkHref  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favourite {
  id         String          @id @default(cuid())
  userId     String
  designerId String
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  designer   DesignerProfile @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@unique([userId, designerId])
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String
  discountPercent Int
  maxDiscountInr  Int
  minOrderInr     Int
  isActive        Boolean  @default(true)
  expiresAt       DateTime
}

model PlatformSettings {
  id                          String  @id @default("default")
  platformName                String  @default("GYD – Get Your Designer")
  defaultCommissionPercent    Float   @default(15)
  requireDesignerVerification Boolean @default(true)
  depositPercentage           Int     @default(30)
  cancellationFreeHours       Int     @default(48)
  partialRefundPercent        Int     @default(50)
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  details    String
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])
}

# GYD – Get Your Designer | Standalone Backend API Configuration
# Copy this to .env and fill in your real values
# NEVER commit .env to version control

PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── MongoDB Atlas (Primary Database) ───────────────────────────────────────
MONGODB_URI="mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB="gyd_marketplace"

# ─── Restricted Admin Portal ─────────────────────────────────────────────────
GYD_ADMIN_EMAIL="admin@getyourdesigner.in"
GYD_ADMIN_PASSWORD="change-this-strong-admin-password"

# ─── Shared Token & Session Secret (Must match GYD-web proxy.ts if set) ──────
AUTH_SECRET="replace-with-32-byte-random-secret"

# ─── Google Maps / Places API ────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY="AIzaSy-replace-with-key"

# ─── Razorpay Payments ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ─── Resend Transactional Emails ─────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxx"
EMAIL_FROM="GYD Concierge <concierge@getyourdesigner.in>"
